# Copy to .env and fill in. Never commit real keys (see .gitignore).
OPENAI_API_KEY=
# Exact model ID (no unversioned alias where the provider supports it).
ADTESTPRO_MODEL=gpt-4o-mini-2024-07-18
# Optional debias hedge: comma-separated pool rotated per persona during scoring
# (respond stage only; extraction/synthesis stay on ADTESTPRO_MODEL). Cost scales
# with pool use. All models must honor json_object mode.
# ADTESTPRO_MODELS=gpt-4o-mini-2024-07-18,openai/gpt-4o-mini
# Optional OpenAI-compatible endpoint. For OpenRouter:
# ADTESTPRO_BASE_URL=https://openrouter.ai/api/v1
# ADTESTPRO_MODEL=openai/gpt-4o-mini  (must be vision-capable for image extraction;
#   json_object mode also varies by model — failures surface as typed extraction errors)
ADTESTPRO_BASE_URL=
# Comma-separated allowed CORS origins for dev.
ALLOWED_ORIGINS=http://localhost:8000,http://127.0.0.1:8000
# Concurrency / budget guards (see llm.py).
ADTESTPRO_MAX_CONCURRENCY=4
ADTESTPRO_TIMEOUT_S=60
