# Copy to .env and fill in. Never commit real keys (see .gitignore).
# Provider API keys are managed in the Settings page (UI) and stored in
# gitignored settings.local.json — .env keys are NOT read by the app.
# .env remains for headless/model config (and the benchmark CLI), not for keys.
# OPENAI_API_KEY / ADTESTPRO_BASE_URL below apply to `benchmarks/evaluate.py` only.
OPENAI_API_KEY=
# Exact model ID (no unversioned alias where the provider supports it).
ADTESTPRO_MODEL=gpt-4o-mini-2024-07-18
# Optional debias hedge: comma-separated pool rotated per persona during scoring
# (respond stage only; extraction/synthesis stay on ADTESTPRO_MODEL). Cost scales
# with pool use. All models must honor json_object mode. Prefer models from at
# least two vendors (see the Settings UI checkboxes) to hedge family bias.
# ADTESTPRO_MODELS=openai/gpt-4o-mini,anthropic/claude-sonnet-5,deepseek/deepseek-v4-flash
# Optional OpenAI-compatible endpoint. For OpenRouter:
# ADTESTPRO_BASE_URL=https://openrouter.ai/api/v1
# ADTESTPRO_MODEL=openai/gpt-4o-mini  (must be vision-capable for image extraction;
#   json_object mode also varies by model — failures surface as typed extraction errors)
ADTESTPRO_BASE_URL=
# Comma-separated allowed CORS origins for dev.
ALLOWED_ORIGINS=http://localhost:8000,http://127.0.0.1:8000
# Concurrency / budget guards (see llm.py).
# ADTESTPRO_TIMEOUT_S must cover ~6k-token structured generations (40-90s under
# load); 120s gives 3x headroom, and initial+repair still fits the run budget.
ADTESTPRO_MAX_CONCURRENCY=4
ADTESTPRO_TIMEOUT_S=180
# Optional dedicated vision model for the single image-extraction call.
# Falls back to ADTESTPRO_MODEL when unset. Must accept image inputs.
# ADTESTPRO_IMAGE_MODEL=google/gemini-3.1-flash-lite-image
