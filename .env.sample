# Copy to .env and fill in. Never commit real keys (see .gitignore).
OPENAI_API_KEY=
# Exact model ID (no unversioned alias where the provider supports it).
ADTESTPRO_MODEL=gpt-4o-mini-2024-07-18
# Comma-separated allowed CORS origins for dev.
ALLOWED_ORIGINS=http://localhost:8000,http://127.0.0.1:8000
# Concurrency / budget guards (see llm.py).
ADTESTPRO_MAX_CONCURRENCY=4
ADTESTPRO_TIMEOUT_S=60
